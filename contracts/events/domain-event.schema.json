{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/med/domain-event/v1",
  "title": "DomainEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "event_type",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "正整数版本字符串"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "description": "信封验证不代替各event_type的payload Schema；对外投递须脱敏并独立授权。",
  "$defs": {
    "InventoryPostedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posting_id",
        "document_id",
        "entity_id",
        "changes"
      ],
      "properties": {
        "posting_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "balance_id",
              "sku_id",
              "qty_delta"
            ],
            "properties": {
              "balance_id": {
                "type": "string",
                "format": "uuid"
              },
              "sku_id": {
                "type": "string",
                "format": "uuid"
              },
              "qty_delta": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "inventory.posted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/InventoryPostedPayload"
          }
        }
      }
    }
  ],
  "examples": [
    {
      "event_id": "00000000-0000-4000-8000-000000000018",
      "tenant_id": "00000000-0000-4000-8000-000000000020",
      "aggregate_type": "shipment",
      "aggregate_id": "00000000-0000-4000-8000-000000000015",
      "aggregate_version": "6",
      "event_type": "inventory.posted",
      "schema_version": 1,
      "occurred_at": "2026-10-08T08:00:00Z",
      "correlation_id": "00000000-0000-4000-8000-000000000019",
      "causation_id": null,
      "payload": {
        "posting_id": "00000000-0000-4000-8000-000000000016",
        "document_id": "00000000-0000-4000-8000-000000000015",
        "entity_id": "00000000-0000-4000-8000-000000000002",
        "changes": [
          {
            "balance_id": "00000000-0000-4000-8000-000000000021",
            "sku_id": "00000000-0000-4000-8000-000000000006",
            "qty_delta": "-8"
          }
        ]
      }
    }
  ]
}